{
  "manifest_version": 3,
  "name": "Network Monitor",
  "version": "1.0",
  "description": "Monitor network requests in real-time with a draggable overlay",
  "permissions": [
    "webRequest",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Toggle Network Monitor"
  }
}